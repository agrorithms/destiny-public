{
  // Stryker's TypeScript checker only (stryker.config.mjs). tsconfig.json includes every
  // **/*.ts — scripts/, e2e/, gos10k/ — and the checker re-checks the whole project per
  // mutant batch, so this narrows it to what a mutant can affect: src/ and the tests over it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
